{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm preview --host 127.0.0.1 --port 4321",
      "url": [
        "http://127.0.0.1:4321/",
        "http://127.0.0.1:4321/projects/",
        "http://127.0.0.1:4321/projects/yolo-object-detection/",
        "http://127.0.0.1:4321/about/",
        "http://127.0.0.1:4321/cv/",
        "http://127.0.0.1:4321/notes/",
        "http://127.0.0.1:4321/now/",
        "http://127.0.0.1:4321/uses/",
        "http://127.0.0.1:4321/en/",
        "http://127.0.0.1:4321/en/projects/",
        "http://127.0.0.1:4321/github/",
        "http://127.0.0.1:4321/security/",
        "http://127.0.0.1:4321/feed/",
        "http://127.0.0.1:4321/en/projects/yolo-object-detection/",
        "http://127.0.0.1:4321/en/notes/why-astro-7/",
        "http://127.0.0.1:4321/experiments/",
        "http://127.0.0.1:4321/timeline/"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--headless=new --no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.75,
            "aggregationMethod": "median"
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 1
          }
        ],
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 2500,
            "aggregationMethod": "median"
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.05,
            "aggregationMethod": "median"
          }
        ],
        "total-blocking-time": [
          "error",
          {
            "maxNumericValue": 1000,
            "aggregationMethod": "median"
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
