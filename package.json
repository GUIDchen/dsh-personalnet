{
  "name": "dsh-personalnet",
  "version": "2.5.0",
  "private": true,
  "type": "module",
  "description": "个人网站：7 个领域、12 个项目案例与 3 篇技术笔记（Astro 7 + Tailwind 4）",
  "license": "MIT",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22.23.4",
    "pnpm": ">=7.1.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:docs": "node scripts/check-docs.mjs",
    "ci:verify": "pnpm lint && pnpm format:check && pnpm check && pnpm test:unit && pnpm build && pnpm test:docs && pnpm test:content && pnpm check:site && pnpm check:media && pnpm check:github && pnpm check:security && pnpm check:admin && pnpm check:contrast && pnpm test:integration && pnpm test:seo && pnpm check:budget",
    "check:contrast": "node scripts/check-contrast.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "test:content": "node scripts/check-content.mjs",
    "check:site": "node scripts/check-site-data.mjs",
    "check:media": "node scripts/check-media.mjs",
    "audit:content": "node scripts/content-audit.mjs",
    "sync:github": "node scripts/sync-github-projects.mjs",
    "check:github": "node scripts/check-github-projects.mjs",
    "check:security": "node scripts/check-security.mjs",
    "check:admin": "node scripts/check-admin.mjs",
    "health": "node scripts/health-report.mjs",
    "deploy:check": "node scripts/deploy-preflight.mjs",
    "gen:og": "node scripts/generate-og.mjs",
    "test:a11y": "playwright test tests/e2e/a11y.spec.ts",
    "test:coverage": "vitest run --coverage",
    "test:integration": "node scripts/check-dist.mjs",
    "check:budget": "node scripts/check-budget.mjs",
    "perf": "lhci autorun",
    "new:project": "node scripts/new-project.mjs",
    "check:links": "node scripts/check-links.mjs",
    "test:seo": "node scripts/check-seo.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.4",
    "@astrojs/markdown-satteri": "0.4.5",
    "@astrojs/mdx": "8.1.1",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.2",
    "astro-pagefind": "2.0.1",
    "pagefind": "1.5.2",
    "tailwindcss": "4.3.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.1",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-plugin-astro": "3.2.1",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5",
    "yaml": "^2.9.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "@tailwindcss/oxide",
      "esbuild"
    ]
  }
}
