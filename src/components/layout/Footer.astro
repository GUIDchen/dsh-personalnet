---
import { profile } from "@/data/profile";
import { profileEn } from "@/data/profile.en";
import { ui, type Lang } from "@/i18n";
import { localizePath } from "@/i18n/routing";

interface Props {
  lang?: Lang;
}

const { lang = "zh" } = Astro.props;
const t = ui[lang];
const person = lang === "en" ? profileEn : profile;
const year = new Date().getFullYear();
const links = [
  { href: localizePath("projects/", lang), label: t.footer.projects },
  { href: localizePath("github/", lang), label: "GitHub" },
  { href: localizePath("notes/", lang), label: t.footer.notes },
  { href: localizePath("now/", lang), label: t.footer.now },
  { href: localizePath("uses/", lang), label: t.footer.uses },
  { href: localizePath("about/", lang), label: t.footer.about },
  { href: localizePath("security/", lang), label: lang === "en" ? "Security" : "安全" },
  { href: `${import.meta.env.BASE_URL}rss.xml`, label: t.footer.rss },
  { href: `mailto:${profile.email}`, label: t.footer.email },
  { href: "#main", label: t.footer.top },
];
---

<footer class="site-footer">
  <div class="page-shell inner">
    <div>
      <p class="name">
        {person.name} <span class="mono-label">/ {person.nameEn}</span>
      </p>
      <p class="meta">
        © {year} · {t.footer.license}
      </p>
    </div>
    <nav aria-label={t.footer.navLabel}>
      <ul>
        {links.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    margin-top: clamp(4rem, 10vw, 8rem);
    padding-block: 5rem 3rem;
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    justify-content: space-between;
    align-items: flex-start;
  }

  .name {
    margin: 0;
    font-weight: 600;
  }

  .meta {
    margin: 0.35rem 0 0;
    color: var(--muted);
    font-size: 0.8125rem;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  a {
    text-decoration: none;
    color: var(--muted);
    font-size: 0.875rem;
  }

  a:hover {
    color: var(--fg);
  }
</style>
