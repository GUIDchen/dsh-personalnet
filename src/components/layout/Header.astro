---
import ThemeToggle from "./ThemeToggle.astro";
import { profile } from "@/data/profile";

const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const basePath = base.replace(/\/$/, "");

const links = [
  { href: base, label: "首页", match: basePath || "/", kbd: "" },
  { href: `${base}projects/`, label: "项目", match: `${basePath}/projects`, kbd: "" },
  { href: `${base}search/`, label: "搜索", match: `${basePath}/search`, kbd: "⌘K" },
  { href: `${base}about/`, label: "关于", match: `${basePath}/about`, kbd: "" },
];

const isActive = (match: string) => (match === "/" ? path === "/" : path.startsWith(match));
---

<header class="site-header" data-site-header>
  <div class="bar page-shell">
    <a class="brand" href={base} aria-label={`${profile.name} 首页`}>
      <span class="brand-mark" aria-hidden="true">
        陈
      </span>
      <span class="brand-name">{profile.name}</span>
    </a>

    <div class="actions">
      <nav id="site-nav" class="nav-panel" aria-label="主导航">
        <ul>
          {links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isActive(link.match) ? "page" : undefined}
                aria-keyshortcuts={link.kbd ? "Meta+K Control+K" : undefined}
              >
                {link.label}
                {link.kbd && (
                  <kbd class="nav-kbd" aria-hidden="true">
                    {link.kbd}
                  </kbd>
                )}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <ThemeToggle />
      <button
        type="button"
        class="menu-toggle"
        aria-expanded="false"
        aria-controls="site-nav"
        data-menu-toggle
      >
        <span class="sr-only">打开导航菜单</span>
        <span class="menu-icon" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<script>
  function setHeaderOpen(open: boolean): void {
    const header = document.querySelector<HTMLElement>("[data-site-header]");
    const toggle = header?.querySelector<HTMLButtonElement>("[data-menu-toggle]");
    if (!header || !toggle) return;
    header.dataset.menuOpen = String(open);
    toggle.setAttribute("aria-expanded", String(open));
    const label = toggle.querySelector(".sr-only");
    if (label) label.textContent = open ? "关闭导航菜单" : "打开导航菜单";
  }

  function initHeader(): void {
    const header = document.querySelector<HTMLElement>("[data-site-header]");
    const toggle = header?.querySelector<HTMLButtonElement>("[data-menu-toggle]");
    if (!header || !toggle || header.dataset.bound === "true") return;
    header.dataset.bound = "true";

    setHeaderOpen(false);
    toggle.addEventListener("click", () => setHeaderOpen(header.dataset.menuOpen !== "true"));
    header.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setHeaderOpen(false));
    });
  }

  // WebKit 点击按钮不会自动聚焦，Esc 需要在 document 上监听；模块只执行一次，避免重复绑定。
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") setHeaderOpen(false);
  });
  document.addEventListener("astro:page-load", initHeader);
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in oklch, var(--bg) 86%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 64px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .brand-mark {
    display: inline-grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 6px;
    background: var(--fg);
    color: var(--bg);
    font-size: 0.8125rem;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .nav-panel ul {
    display: flex;
    align-items: center;
    gap: 1.35rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-panel a {
    text-decoration: none;
    color: var(--muted);
    font-size: 0.9375rem;
    padding-block: 0.25rem;
    border-bottom: 1px solid transparent;
  }

  .nav-panel a:hover {
    color: var(--fg);
  }

  .nav-panel a[aria-current="page"] {
    color: var(--fg);
    border-bottom-color: var(--accent);
  }

  .nav-kbd {
    margin-left: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: var(--muted);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.05rem 0.3rem;
  }

  @media (max-width: 767px) {
    .nav-kbd {
      display: none;
    }
  }

  .menu-toggle {
    display: none;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: transparent;
    color: var(--fg);
    cursor: pointer;
  }

  .menu-icon,
  .menu-icon::before,
  .menu-icon::after {
    display: block;
    width: 18px;
    height: 1.5px;
    background: currentColor;
    position: relative;
    transition: transform var(--dur-2) var(--ease-out);
  }

  .menu-icon::before,
  .menu-icon::after {
    content: "";
    position: absolute;
    left: 0;
  }

  .menu-icon::before {
    top: -6px;
  }

  .menu-icon::after {
    top: 6px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 767px) {
    :global(.js) .menu-toggle {
      display: inline-flex;
    }

    :global(.js) .nav-panel {
      display: none;
      position: absolute;
      left: 0;
      right: 0;
      top: 100%;
      padding: 1rem var(--page-pad) 1.5rem;
      background: var(--bg);
      border-bottom: 1px solid var(--border);
    }

    :global(.js) [data-menu-open="true"] .nav-panel {
      display: block;
    }

    :global(.js) .nav-panel ul {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.9rem;
    }

    :global(.js) .nav-panel a {
      font-size: 1.05rem;
    }
  }
</style>
