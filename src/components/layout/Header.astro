---
import ThemeToggle from "./ThemeToggle.astro";
import { profile } from "@/data/profile";
import { profileEn } from "@/data/profile.en";
import { ui, type Lang } from "@/i18n";
import { localizePath, stripBase, switchLanguagePath } from "@/i18n/routing";

interface Props {
  lang?: Lang;
}

const { lang = "zh" } = Astro.props;
const t = ui[lang];
const local = stripBase(Astro.url.pathname)
  .replace(/^\/+/, "")
  .replace(/^en\/?/, "")
  .replace(/\/$/, "");

const links = [
  { path: "", segment: "", label: t.nav.home, kbd: "" },
  { path: "projects/", segment: "projects", label: t.nav.projects, kbd: "" },
  { path: "notes/", segment: "notes", label: t.nav.notes, kbd: "" },
  { path: "search/", segment: "search", label: t.nav.search, kbd: "⌘K" },
  { path: "about/", segment: "about", label: t.nav.about, kbd: "" },
].map((link) => ({ ...link, href: localizePath(link.path, lang) }));

const isActive = (segment: string) =>
  segment === "" ? local === "" : local === segment || local.startsWith(segment + "/");

const otherLang: Lang = lang === "zh" ? "en" : "zh";
const switchHref = switchLanguagePath(Astro.url.pathname, otherLang);
---

<header
  class="site-header"
  data-site-header
  data-label-open={t.menu.open}
  data-label-close={t.menu.close}
>
  <div class="bar page-shell">
    <a class="brand" href={localizePath("", lang)}>
      <span class="brand-mark" aria-hidden="true">
        陈
      </span>
      <span class="brand-name">{lang === "en" ? profileEn.name : profile.name}</span>
    </a>

    <div class="actions">
      <nav id="site-nav" class="nav-panel" aria-label={t.navLabel}>
        <ul>
          {links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isActive(link.segment) ? "page" : undefined}
                aria-keyshortcuts={link.kbd ? "Meta+K Control+K" : undefined}
              >
                {link.label}
                {link.kbd && (
                  <kbd class="nav-kbd" aria-hidden="true">
                    {link.kbd}
                  </kbd>
                )}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <a
        class="lang-switch"
        href={switchHref}
        hreflang={otherLang === "zh" ? "zh-CN" : "en"}
        lang={otherLang === "zh" ? "zh-CN" : "en"}
      >
        {t.language.short}
        <span class="sr-only">{t.language.switch}</span>
      </a>
      <ThemeToggle lang={lang} />
      <button
        type="button"
        class="menu-toggle"
        aria-expanded="false"
        aria-controls="site-nav"
        data-menu-toggle
      >
        <span class="sr-only">{t.menu.open}</span>
        <span class="menu-icon" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<script>
  function setHeaderOpen(open: boolean): void {
    const header = document.querySelector<HTMLElement>("[data-site-header]");
    const toggle = header?.querySelector<HTMLButtonElement>("[data-menu-toggle]");
    if (!header || !toggle) return;
    header.dataset.menuOpen = String(open);
    toggle.setAttribute("aria-expanded", String(open));
    const label = toggle.querySelector(".sr-only");
    if (label) {
      label.textContent = (open ? header.dataset.labelClose : header.dataset.labelOpen) ?? "";
    }
  }

  function initHeader(): void {
    const header = document.querySelector<HTMLElement>("[data-site-header]");
    const toggle = header?.querySelector<HTMLButtonElement>("[data-menu-toggle]");
    if (!header || !toggle || header.dataset.bound === "true") return;
    header.dataset.bound = "true";

    setHeaderOpen(false);
    toggle.addEventListener("click", () => setHeaderOpen(header.dataset.menuOpen !== "true"));
    header.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setHeaderOpen(false));
    });
  }

  // WebKit 点击按钮不会自动聚焦，Esc 需要在 document 上监听；模块只执行一次，避免重复绑定。
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") setHeaderOpen(false);
  });
  document.addEventListener("astro:page-load", initHeader);
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in oklch, var(--bg) 95%, transparent);
    border-bottom: 1px solid var(--border);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 64px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .brand-mark {
    display: inline-grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 6px;
    background: var(--fg);
    color: var(--bg);
    font-size: 0.8125rem;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .lang-switch {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 0.2rem 0.55rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    text-decoration: none;
  }

  .lang-switch:hover {
    border-color: var(--border-strong);
    color: var(--fg);
  }

  .nav-panel ul {
    display: flex;
    align-items: center;
    gap: 1.35rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-panel a {
    text-decoration: none;
    color: var(--muted);
    font-size: 0.9375rem;
    padding-block: 0.25rem;
    border-bottom: 1px solid transparent;
  }

  .nav-panel a:hover {
    color: var(--fg);
  }

  .nav-panel a[aria-current="page"] {
    color: var(--fg);
    border-bottom-color: var(--accent);
  }

  .nav-kbd {
    margin-left: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: var(--muted);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.05rem 0.3rem;
  }

  @media (max-width: 767px) {
    .nav-kbd {
      display: none;
    }
  }

  .menu-toggle {
    display: none;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: transparent;
    color: var(--fg);
    cursor: pointer;
  }

  .menu-icon,
  .menu-icon::before,
  .menu-icon::after {
    display: block;
    width: 18px;
    height: 1.5px;
    background: currentColor;
    position: relative;
    transition: transform var(--dur-2) var(--ease-out);
  }

  .menu-icon::before,
  .menu-icon::after {
    content: "";
    position: absolute;
    left: 0;
  }

  .menu-icon::before {
    top: -6px;
  }

  .menu-icon::after {
    top: 6px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 767px) {
    :global(.js) .menu-toggle {
      display: inline-flex;
    }

    :global(.js) .nav-panel {
      display: none;
      position: absolute;
      left: 0;
      right: 0;
      top: 100%;
      padding: 1rem var(--page-pad) 1.5rem;
      background: var(--bg);
      border-bottom: 1px solid var(--border);
    }

    :global(.js) [data-menu-open="true"] .nav-panel {
      display: block;
    }

    :global(.js) .nav-panel ul {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.9rem;
    }

    :global(.js) .nav-panel a {
      font-size: 1.05rem;
    }
  }
</style>
