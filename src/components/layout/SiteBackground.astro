---
interface Props {
  lang?: "zh" | "en";
}
const { lang = "zh" } = Astro.props;
---

<div class="site-bg" aria-hidden="true" data-site-background>
  <div class="site-bg__aurora"></div>
  <div class="site-bg__grid"></div>
  <div class="site-bg__fade"></div>
  <span class="site-bg__label">{lang === "en" ? "ambient grid" : "环境网格"}</span>
</div>

<style>
  .site-bg {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    background:
      radial-gradient(
        120% 80% at 50% -10%,
        color-mix(in oklch, var(--accent) 7%, transparent),
        transparent 60%
      ),
      var(--bg);
  }

  .site-bg__aurora {
    position: absolute;
    inset: -20%;
    opacity: 0.42;
    background:
      radial-gradient(
        38% 32% at 18% 22%,
        color-mix(in oklch, var(--accent) 22%, transparent),
        transparent 70%
      ),
      radial-gradient(
        32% 28% at 78% 12%,
        color-mix(in oklch, var(--fg) 9%, transparent),
        transparent 70%
      ),
      radial-gradient(
        36% 30% at 62% 78%,
        color-mix(in oklch, var(--accent) 12%, transparent),
        transparent 70%
      );
    animation: aurora-drift 36s var(--ease-in-out) infinite alternate;
  }

  .site-bg__grid {
    position: absolute;
    inset: -12% -20% -20%;
    opacity: 0.16;
    background-image:
      linear-gradient(color-mix(in oklch, var(--fg) 16%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in oklch, var(--fg) 16%, transparent) 1px, transparent 1px);
    background-size: 72px 72px;
    transform: perspective(640px) rotateX(58deg) translateY(4%);
    transform-origin: 50% 0;
    mask-image: linear-gradient(to bottom, transparent 4%, black 24%, black 64%, transparent 96%);
  }

  .site-bg__fade {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      color-mix(in oklch, var(--bg) 18%, transparent),
      transparent 24%,
      transparent 72%,
      color-mix(in oklch, var(--bg) 60%, transparent)
    );
  }

  .site-bg__label {
    position: absolute;
    right: clamp(1rem, 4vw, 3rem);
    bottom: 1.2rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.35;
  }

  @keyframes aurora-drift {
    from {
      transform: translate3d(-2%, -1%, 0) scale(1);
    }
    to {
      transform: translate3d(3%, 2%, 0) scale(1.06);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-bg__aurora {
      animation: none;
    }
  }

  @media (max-width: 639px) {
    .site-bg__aurora {
      animation: none;
    }

    .site-bg__grid {
      opacity: 0.1;
      background-size: 48px 48px;
    }

    .site-bg__label {
      display: none;
    }
  }
</style>
