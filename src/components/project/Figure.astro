---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
}

const { src, alt, caption } = Astro.props;
---

<figure class="figure">
  <Image
    src={src}
    alt={alt}
    widths={[640, 960, 1280]}
    sizes="(max-width: 960px) 100vw, 760px"
    loading="lazy"
    decoding="async"
  />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .figure {
    margin: 2rem 0;
  }

  .figure :global(img) {
    width: 100%;
    height: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
  }

  figcaption {
    margin-top: 0.5rem;
    font-size: 0.8125rem;
    color: var(--muted);
  }
</style>
