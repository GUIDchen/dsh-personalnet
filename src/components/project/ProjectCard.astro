---
import { getDomainMeta } from "@/data/domains";
import type { ProjectView } from "@/lib/content";
import { formatYearRange } from "@/lib/seo";
import type { Lang } from "@/i18n";
import Badge from "@/components/ui/Badge.astro";

interface Props {
  project: ProjectView;
  index: number;
  level?: 2 | 3;
  lang?: Lang;
}

const { project, index, level = 3, lang = "zh" } = Astro.props;
const Heading = level === 2 ? "h2" : "h3";
const { data, id } = project;
const domain = getDomainMeta(data.domain, lang);
const year = formatYearRange(data.timeframe);
const number = String(index).padStart(2, "0");
---

<article class="project-card">
  <a
    class="card-link"
    href={`${import.meta.env.BASE_URL}projects/${id}/`}
    hreflang={lang === "en" ? "zh-CN" : undefined}
  >
    <div class="card-top">
      <span class="mono-label">{number}</span>
      <span class="mono-label">{year}</span>
    </div>
    <p class="domain">{domain.label}</p>
    <Heading class="title" lang={lang === "en" ? "zh-CN" : undefined}>
      {data.title}
    </Heading>
    <p class="summary" lang={lang === "en" ? "zh-CN" : undefined}>
      {data.summary}
    </p>
    <ul class="tags" aria-label={lang === "en" ? "Tags" : "标签"}>
      {data.tags.slice(0, 3).map((tag) => (
        <li>
          <Badge tone="outline" mono>
            {tag}
          </Badge>
        </li>
      ))}
    </ul>
    <span class="arrow" aria-hidden="true">
      →
    </span>
  </a>
</article>

<style>
  .project-card {
    height: 100%;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: color-mix(in oklch, var(--surface) 55%, transparent);
    transition:
      border-color var(--dur-2) var(--ease-out),
      background-color var(--dur-2) var(--ease-out);
  }

  .project-card:hover {
    border-color: var(--border-strong);
  }

  .card-link {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: clamp(1.1rem, 2.5vw, 1.6rem);
    height: 100%;
    text-decoration: none;
    position: relative;
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }

  .domain {
    margin: 0.35rem 0 0;
    font-size: 0.8125rem;
    color: var(--accent);
  }

  .title {
    margin: 0;
    font-size: clamp(1.15rem, 2vw, 1.4rem);
    letter-spacing: -0.01em;
  }

  .card-link:hover .title {
    color: var(--accent);
  }

  .summary {
    margin: 0;
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.65;
  }

  .tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0.5rem 0 0;
    padding: 0;
  }

  .arrow {
    margin-top: auto;
    padding-top: 1rem;
    color: var(--muted);
    transition: transform var(--dur-2) var(--ease-out);
  }

  .card-link:hover .arrow {
    transform: translateX(4px);
    color: var(--accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .card-link:hover .arrow {
      transform: none;
    }
  }
</style>
