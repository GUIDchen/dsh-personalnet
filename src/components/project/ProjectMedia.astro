---
import { resolveMediaUrl } from "@/lib/media";

interface Props {
  src: string;
  alt: string;
  loading?: "lazy" | "eager";
  class?: string;
}

const { src, alt, loading = "lazy", class: className } = Astro.props;
const base = import.meta.env.BASE_URL;
const url = resolveMediaUrl(src, base);
---

<img class={className} src={url} alt={alt} loading={loading} decoding="async" data-media />
