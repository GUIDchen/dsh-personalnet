---
interface Props {
  email: string;
}

const { email } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<dialog class="palette" data-palette-dialog aria-labelledby="palette-title">
  <div class="palette-head">
    <h2 id="palette-title" class="sr-only">
      命令面板
    </h2>
    <input
      type="text"
      data-palette-input
      placeholder="输入命令或页面名称…"
      autocomplete="off"
      spellcheck="false"
      aria-controls="palette-list"
      aria-autocomplete="list"
    />
    <kbd>Esc</kbd>
  </div>

  <ul id="palette-list" class="palette-list" data-palette-list role="listbox" aria-label="命令">
    <li role="option" data-palette-item data-href={`${base}`} data-label="首页">
      <span>首页</span>
      <span class="hint">Home</span>
    </li>
    <li
      role="option"
      data-palette-item
      data-href={`${base}projects/`}
      data-label="项目 项目库 作品"
    >
      <span>项目</span>
      <span class="hint">Projects</span>
    </li>
    <li role="option" data-palette-item data-href={`${base}notes/`} data-label="笔记 文章 notes">
      <span>笔记</span>
      <span class="hint">Notes</span>
    </li>
    <li role="option" data-palette-item data-href={`${base}now/`} data-label="现在 now 状态">
      <span>现在在做什么</span>
      <span class="hint">Now</span>
    </li>
    <li role="option" data-palette-item data-href={`${base}uses/`} data-label="工具 uses">
      <span>常用工具</span>
      <span class="hint">Uses</span>
    </li>
    <li role="option" data-palette-item data-href={`${base}about/`} data-label="关于 about">
      <span>关于</span>
      <span class="hint">About</span>
    </li>
    <li role="option" data-palette-item data-href={`${base}cv/`} data-label="简历 cv">
      <span>简历</span>
      <span class="hint">CV</span>
    </li>
    <li
      role="option"
      data-palette-item
      data-href={`${base}search/?focus=1`}
      data-label="搜索 search"
    >
      <span>搜索</span>
      <span class="hint">Search</span>
    </li>
    <li role="option" data-palette-item data-action="theme" data-label="主题 深色 浅色 theme">
      <span>切换主题</span>
      <span class="hint">Theme</span>
    </li>
    <li
      role="option"
      data-palette-item
      data-action="copy-email"
      data-label="复制邮箱 email"
      data-email={email}
    >
      <span>复制邮箱</span>
      <span class="hint">{email}</span>
    </li>
    <li role="option" data-palette-item data-href={`${base}rss.xml`} data-label="rss 订阅">
      <span>RSS 订阅</span>
      <span class="hint">RSS</span>
    </li>
  </ul>

  <p class="palette-empty" data-palette-empty hidden>
    没有匹配的命令
  </p>
  <p class="palette-foot">
    <span>↑↓ 选择</span>
    <span>Enter 执行</span>
    <span>Esc 关闭</span>
  </p>
</dialog>

<style>
  .palette {
    width: min(92vw, 34rem);
    margin: 12vh auto auto;
    padding: 0;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    background: var(--bg);
    color: var(--fg);
    box-shadow: 0 30px 80px rgb(0 0 0 / 0.35);
  }

  .palette::backdrop {
    background: rgb(0 0 0 / 0.55);
    backdrop-filter: blur(3px);
  }

  .palette-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--border);
  }

  .palette-head input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    color: var(--fg);
    font: inherit;
    font-size: 1rem;
    padding: 0.4rem 0;
    outline: none;
  }

  .palette-head kbd {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--muted);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.1rem 0.35rem;
  }

  .palette-list {
    list-style: none;
    margin: 0;
    padding: 0.4rem;
    max-height: min(55vh, 24rem);
    overflow-y: auto;
  }

  .palette-list li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.55rem 0.75rem;
    border-radius: var(--radius-md);
    cursor: pointer;
    font-size: 0.9375rem;
  }

  .palette-list li[aria-selected="true"],
  .palette-list li:hover {
    background: var(--surface);
  }

  .hint {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--muted);
  }

  .palette-empty {
    margin: 0;
    padding: 1.25rem 1rem;
    text-align: center;
    color: var(--muted);
    font-size: 0.875rem;
  }

  .palette-foot {
    display: flex;
    gap: 1rem;
    margin: 0;
    padding: 0.6rem 1rem;
    border-top: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    color: var(--muted);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
