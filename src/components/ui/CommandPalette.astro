---
import { ui, type Lang } from "@/i18n";
import { localizePath } from "@/i18n/routing";

interface Props {
  email: string;
  lang?: Lang;
}

const { email, lang = "zh" } = Astro.props;
const t = ui[lang];

const entries = [
  { key: "home", href: localizePath("", lang) },
  { key: "projects", href: localizePath("projects/", lang) },
  { key: "github", href: localizePath("github/", lang) },
  { key: "notes", href: localizePath("notes/", lang) },
  { key: "now", href: localizePath("now/", lang) },
  { key: "uses", href: localizePath("uses/", lang) },
  { key: "about", href: localizePath("about/", lang) },
  { key: "cv", href: localizePath("cv/", lang) },
  { key: "search", href: `${localizePath("search/", lang)}?focus=1` },
  { key: "theme", action: "theme" },
  { key: "email", action: "copy-email", hint: email },
  { key: "rss", href: localizePath("feed/", lang) },
] as const;

const items = entries.map((entry) => {
  const [label, hint] = t.palette.items[entry.key];
  return {
    ...entry,
    label,
    hint: "hint" in entry ? entry.hint : hint,
  };
});
---

<dialog class="palette" data-palette-dialog aria-labelledby="palette-title">
  <div class="palette-head">
    <h2 id="palette-title" class="sr-only">
      {t.palette.title}
    </h2>
    <input
      type="text"
      data-palette-input
      placeholder={t.palette.placeholder}
      autocomplete="off"
      spellcheck="false"
      aria-controls="palette-list"
      aria-autocomplete="list"
    />
    <kbd>Esc</kbd>
  </div>

  <ul
    id="palette-list"
    class="palette-list"
    data-palette-list
    role="listbox"
    aria-label={t.palette.title}
  >
    {items.map((item) => (
      <li
        role="option"
        data-palette-item
        data-href={"href" in item ? item.href : undefined}
        data-action={"action" in item ? item.action : undefined}
        data-email={item.key === "email" ? email : undefined}
        data-copied={item.key === "email" ? t.common.copyEmail : undefined}
        data-label={`${item.label} ${item.hint}`}
      >
        <span>{item.label}</span>
        <span class="hint">{item.hint}</span>
      </li>
    ))}
  </ul>

  <p class="palette-empty" data-palette-empty hidden>
    {t.palette.empty}
  </p>
  <p class="palette-foot">
    {t.palette.footer.map((label) => (
      <span>{label}</span>
    ))}
  </p>
</dialog>
<style>
  .palette {
    width: min(92vw, 34rem);
    margin: 12vh auto auto;
    padding: 0;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    background: var(--bg);
    color: var(--fg);
    box-shadow: 0 30px 80px rgb(0 0 0 / 0.35);
  }

  .palette::backdrop {
    background: rgb(0 0 0 / 0.62);
  }

  .palette-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--border);
  }

  .palette-head input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    color: var(--fg);
    font: inherit;
    font-size: 1rem;
    padding: 0.4rem 0;
    outline: none;
  }

  .palette-head kbd {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--muted);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.1rem 0.35rem;
  }

  .palette-list {
    list-style: none;
    margin: 0;
    padding: 0.4rem;
    max-height: min(55vh, 24rem);
    overflow-y: auto;
  }

  .palette-list li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.55rem 0.75rem;
    border-radius: var(--radius-md);
    cursor: pointer;
    font-size: 0.9375rem;
  }

  .palette-list li[aria-selected="true"],
  .palette-list li:hover {
    background: var(--surface);
  }

  .hint {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--muted);
  }

  .palette-empty {
    margin: 0;
    padding: 1.25rem 1rem;
    text-align: center;
    color: var(--muted);
    font-size: 0.875rem;
  }

  .palette-foot {
    display: flex;
    gap: 1rem;
    margin: 0;
    padding: 0.6rem 1rem;
    border-top: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    color: var(--muted);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
