---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Header from "@/components/layout/Header.astro";
import Footer from "@/components/layout/Footer.astro";
import CommandPalette from "@/components/ui/CommandPalette.astro";
import Meta from "@/components/seo/Meta.astro";
import { profile } from "@/data/profile";
import { htmlLang, ui, type Lang } from "@/i18n";
import { getAlternates, getLangFromUrl, type Alternates } from "@/i18n/routing";

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  image?: string;
  lang?: Lang;
  alternates?: Alternates;
}

const {
  title,
  description,
  noindex = false,
  image,
  lang = getLangFromUrl(Astro.url.pathname),
} = Astro.props;
const t = ui[lang];
const alternates = Astro.props.alternates ?? getAlternates(Astro.url.pathname, lang);
const descriptionText =
  description ??
  (lang === "en" ? "Chen Longgang — AI, data and software engineering." : profile.tagline);
---

<!doctype html>
<html lang={htmlLang[lang]} data-lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <ClientRouter />
    <Meta
      title={title}
      description={descriptionText}
      noindex={noindex}
      image={image}
      lang={lang}
      alternates={alternates}
    />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <script is:inline>
      (() => {
        const apply = () => {
          document.documentElement.classList.add("js");
          try {
            const stored = localStorage.getItem("theme");
            const theme =
              stored === "light" || stored === "dark"
                ? stored
                : window.matchMedia("(prefers-color-scheme: dark)").matches
                  ? "dark"
                  : "light";
            document.documentElement.dataset.theme = theme;
          } catch {
            /* 忽略隐私模式下的异常 */
          }
        };

        apply();

        // 视图过渡会替换 body，并可能重置 <html> 上的运行时属性，需要在交换后重新应用。
        document.addEventListener("astro:after-swap", apply);
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      {t.skip}
    </a>
    <Header lang={lang} />
    <main id="main" data-pagefind-body {...(noindex ? { "data-pagefind-ignore": "" } : {})}>
      <div class="page-shell">
        <slot />
      </div>
    </main>
    <Footer lang={lang} />
    <CommandPalette email={profile.email} lang={lang} />
    <script>
      import "@/scripts/command-palette";
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 100;
    background: var(--accent);
    color: var(--accent-fg);
    padding: 0.75rem 1rem;
  }

  .skip-link:focus {
    left: 1rem;
    top: 1rem;
  }

  main {
    padding-block: clamp(2.5rem, 6vw, 5rem) 0;
    min-height: 60svh;
  }
</style>
