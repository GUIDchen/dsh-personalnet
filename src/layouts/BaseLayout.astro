---
import "../styles/global.css";
import Header from "@/components/layout/Header.astro";
import Footer from "@/components/layout/Footer.astro";
import Meta from "@/components/seo/Meta.astro";
import { profile } from "@/data/profile";

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const { title, description = profile.tagline, noindex = false } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Meta title={title} description={description} noindex={noindex} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <script is:inline>
      (() => {
        document.documentElement.classList.add("js");
        try {
          const stored = localStorage.getItem("theme");
          const theme =
            stored === "light" || stored === "dark"
              ? stored
              : window.matchMedia("(prefers-color-scheme: dark)").matches
                ? "dark"
                : "light";
          document.documentElement.dataset.theme = theme;
        } catch {
          /* 忽略隐私模式下的异常 */
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      跳到主要内容
    </a>
    <Header />
    <main id="main">
      <div class="page-shell">
        <slot />
      </div>
    </main>
    <Footer />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 100;
    background: var(--accent);
    color: var(--accent-fg);
    padding: 0.75rem 1rem;
  }

  .skip-link:focus {
    left: 1rem;
    top: 1rem;
  }

  main {
    padding-block: clamp(2.5rem, 6vw, 5rem) 0;
    min-height: 60svh;
  }
</style>
