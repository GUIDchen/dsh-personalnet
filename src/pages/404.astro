---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/ui/Button.astro";
---

<BaseLayout title="页面不存在" noindex>
  <section class="not-found">
    <p class="code">404</p>
    <h1>这个页面不存在</h1>
    <p class="lead">链接可能已经失效，或者项目换了名字。</p>
    <div class="actions">
      <Button href={import.meta.env.BASE_URL}>返回首页</Button>
      <Button href={`${import.meta.env.BASE_URL}projects/`} variant="secondary">
        浏览项目
      </Button>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    padding-block: clamp(3rem, 10vw, 7rem);
    max-width: 40rem;
  }

  .code {
    margin: 0;
    font-family: var(--font-mono);
    font-size: clamp(4rem, 18vw, 12rem);
    line-height: 0.9;
    letter-spacing: -0.06em;
    color: var(--border-strong);
  }

  h1 {
    margin: 1rem 0 0.75rem;
    font-size: clamp(1.6rem, 4vw, 2.5rem);
    letter-spacing: -0.02em;
  }

  .lead {
    margin: 0;
    color: var(--muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
</style>
