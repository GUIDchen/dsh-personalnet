---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/ui/Button.astro";
import { copy, type Lang } from "@/i18n";
import { localizePath } from "@/i18n/routing";

interface Props {
  lang?: Lang;
}

const { lang = "zh" } = Astro.props;
const c = copy[lang].notFound;
---

<BaseLayout title={c.title} noindex lang={lang}>
  <section class="not-found">
    <p class="code">404</p>
    <h1>{c.title}</h1>
    <p class="lead">{c.lead}</p>
    <div class="actions">
      <Button href={localizePath("", lang)}>{c.home}</Button>
      <Button href={localizePath("projects/", lang)} variant="secondary">
        {c.projects}
      </Button>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    padding-block: clamp(3rem, 10vw, 7rem);
    max-width: 40rem;
  }

  .code {
    margin: 0;
    font-family: var(--font-mono);
    font-size: clamp(4rem, 18vw, 12rem);
    line-height: 0.9;
    letter-spacing: -0.06em;
    color: var(--border-strong);
  }

  h1 {
    margin: 1rem 0 0.75rem;
    font-size: clamp(1.6rem, 4vw, 2.5rem);
    letter-spacing: -0.02em;
  }

  .lead {
    margin: 0;
    color: var(--muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
</style>
