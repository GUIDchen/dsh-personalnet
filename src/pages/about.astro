---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Badge from "@/components/ui/Badge.astro";
import Button from "@/components/ui/Button.astro";
import { profile } from "@/data/profile";
import { profileEn } from "@/data/profile.en";
import { SKILL_GROUPS } from "@/data/skills";
import { SKILL_GROUPS_EN } from "@/data/skills.en";
import { TIMELINE } from "@/data/timeline";
import { TIMELINE_EN } from "@/data/timeline.en";
import JsonLd from "@/components/seo/JsonLd.astro";
import { personJsonLd } from "@/lib/jsonld";
import { copy, type Lang } from "@/i18n";
import { localizePath } from "@/i18n/routing";

interface Props {
  lang?: Lang;
}

const { lang = "zh" } = Astro.props;
const c = copy[lang].about;
const person = lang === "en" ? profileEn : profile;
const skills = lang === "en" ? SKILL_GROUPS_EN : SKILL_GROUPS;
const timeline = lang === "en" ? TIMELINE_EN : TIMELINE;
const kindLabel = (kind: string) =>
  lang === "en" ? ({ 工作: "Work", 教育: "Education", 科研: "Research" }[kind] ?? kind) : kind;
---

<BaseLayout
  title={lang === "en" ? "About" : "关于"}
  description={lang === "en" ? person.bioShort : person.bio}
  lang={lang}
>
  <JsonLd data={personJsonLd()} />

  <header class="page-head">
    <p class="mono-label">{c.kicker}</p>
    <h1>
      {c.title[0]}
      <br />
      {c.title[1]}
    </h1>
    <p class="lead">{person.bio}</p>
    <div class="actions">
      <Button href={`mailto:${person.email}`}>{c.actions.email}</Button>
      <Button href={localizePath("projects/", lang)} variant="secondary">
        {c.actions.projects}
      </Button>
      <Button href={localizePath("cv/", lang)} variant="secondary">
        {c.actions.cv}
      </Button>
    </div>
  </header>

  <section class="section" aria-labelledby="story-title">
    <h2 id="story-title">{c.storyTitle}</h2>
    <div class="prose story">
      {c.story.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </div>
  </section>

  <section class="section" aria-labelledby="skills-title">
    <h2 id="skills-title">{c.skillsTitle}</h2>
    <div class="skills">
      {skills.map((group) => (
        <div>
          <h3>{group.label}</h3>
          <ul>
            {group.items.map((item) => (
              <li>
                <Badge tone="outline">{item}</Badge>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section class="section" aria-labelledby="timeline-title">
    <h2 id="timeline-title">{c.timelineTitle}</h2>
    <ol class="timeline">
      {timeline.map((item) => (
        <li>
          <span class="period">{item.period}</span>
          <div>
            <h3>{item.title}</h3>
            <p class="org">{item.org}</p>
            {item.detail && <p class="detail">{item.detail}</p>}
          </div>
          <span class="kind">{kindLabel(item.kind)}</span>
        </li>
      ))}
    </ol>
  </section>

  <section class="section" aria-labelledby="contact-title">
    <h2 id="contact-title">{c.contactTitle}</h2>
    <p class="contact-line">
      <span class="mono-label">{c.labels.email}</span>
      <a href={`mailto:${person.email}`}>{person.email}</a>
    </p>
    <p class="contact-line">
      <span class="mono-label">{c.labels.location}</span>
      <span>{person.location}</span>
    </p>
  </section>
</BaseLayout>

<style>
  .page-head {
    max-width: 48rem;
  }

  h1 {
    margin: 0.75rem 0 1.5rem;
    font-size: clamp(2.25rem, 6vw, 4.25rem);
    line-height: 1.05;
    letter-spacing: -0.045em;
  }

  .lead {
    margin: 0;
    font-size: clamp(1.05rem, 1.9vw, 1.3rem);
    color: var(--muted);
    max-width: 40rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .section {
    margin-top: clamp(3.5rem, 8vw, 6rem);
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .section h2 {
    margin: 0 0 1.5rem;
    font-size: clamp(1.3rem, 2.6vw, 1.8rem);
    letter-spacing: -0.02em;
  }

  .story {
    max-width: 44rem;
  }

  .skills {
    display: grid;
    gap: 2rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
  }

  .skills h3 {
    margin: 0 0 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 500;
  }

  .skills ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border);
  }

  .timeline li {
    display: grid;
    grid-template-columns: 10rem 1fr auto;
    gap: 1rem;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--border);
    align-items: baseline;
  }

  .period {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
  }

  .timeline h3 {
    margin: 0;
    font-size: 1.05rem;
  }

  .org {
    margin: 0.2rem 0 0;
    font-size: 0.875rem;
    color: var(--accent);
  }

  .detail {
    margin: 0.45rem 0 0;
    font-size: 0.875rem;
    color: var(--muted);
    max-width: 44rem;
  }

  .kind {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--muted);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.15rem 0.55rem;
  }

  .contact-line {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem;
    margin: 0 0 0.75rem;
  }

  .contact-line a {
    font-size: 1.05rem;
  }

  @media (max-width: 767px) {
    .timeline li {
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }

    .kind {
      justify-self: start;
    }
  }
</style>
