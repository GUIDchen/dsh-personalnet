---
import { getEntry, render } from "astro:content";
import NoteDetail from "@/components/note/NoteDetail.astro";
import { getPublishedNotes, estimateReadingTime } from "@/lib/notes";

export async function getStaticPaths() {
  const notes = await getPublishedNotes();
  return notes.map((note) => ({ params: { slug: note.id }, props: { note } }));
}

const { note } = Astro.props;
const translated = await getEntry("notes-en", note.id);
if (!translated) throw new Error("Missing English body for note: " + note.id);
const { Content, headings } = await render(translated);
const readingTime = estimateReadingTime(translated.body ?? "");
---

<NoteDetail note={note} Content={Content} headings={headings} lang="en" readingTime={readingTime} />
