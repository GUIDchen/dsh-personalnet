---
import { getEntry, render } from "astro:content";
import ProjectDetail from "@/components/project/ProjectDetail.astro";
import { getPublishedProjects } from "@/lib/content";

export async function getStaticPaths() {
  const projects = await getPublishedProjects();
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const translated = await getEntry("projects-en", project.id);
if (!translated) throw new Error("Missing English body for project: " + project.id);
const { Content, headings } = await render(translated);
---

<ProjectDetail project={project} Content={Content} headings={headings} lang="en" />
