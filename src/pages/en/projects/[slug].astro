---
import { getEntry, render } from "astro:content";
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Badge from "@/components/ui/Badge.astro";
import ProjectCard from "@/components/project/ProjectCard.astro";
import Gallery from "@/components/project/Gallery.astro";
import RepoLink from "@/components/project/RepoLink.astro";
import ProjectMedia from "@/components/project/ProjectMedia.astro";
import Toc from "@/components/project/Toc.astro";
import JsonLd from "@/components/seo/JsonLd.astro";
import { getPublishedProjects, getRelatedProjects } from "@/lib/content";
import { DOMAIN_META } from "@/data/domains";
import placeholders from "@/data/cover-placeholders.json";
import { breadcrumbJsonLd, projectJsonLd } from "@/lib/jsonld";

export async function getStaticPaths() {
  const projects = await getPublishedProjects();
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const translated = await getEntry("projects-en", project.id);
if (!translated) throw new Error("Missing English body for project: " + project.id);
const { Content, headings } = await render(translated);
const covers = import.meta.glob<{ default: ImageMetadata }>("../../assets/covers/*.jpg", {
  eager: true,
});
const cover = covers[`../../assets/covers/${project.id}.jpg`];
const lqip = (placeholders as Record<string, string>)[project.id];
const { data } = project;
const galleryAssets = import.meta.glob<{ default: ImageMetadata }>(
  "../../assets/projects/**/*.{jpg,jpeg,png,webp,avif}",
  { eager: true },
);
const galleryImages = data.gallery.map((item, index) => {
  const asset = galleryAssets[`../../assets/projects/${item.src}`]?.default;
  return { src: asset?.src ?? item.src, alt: `${data.titleEn ?? data.title} figure ${index + 1}` };
});
const domain = DOMAIN_META[data.domain];
const statusLabels = {
  active: "Active",
  completed: "Completed",
  archived: "Archived",
  experimental: "Experimental",
} as const;
const statusLabel = statusLabels[data.status];
const related = await getRelatedProjects(project, 3);
const period = data.timeframe.ongoing
  ? `${data.timeframe.start} – present`
  : data.timeframe.end
    ? `${data.timeframe.start} – ${data.timeframe.end}`
    : data.timeframe.start;
const base = import.meta.env.BASE_URL;
const title = data.titleEn ?? data.title;
const seoTitle =
  project.id === "multimodal-medical-diagnosis"
    ? "Multimodal Medical Diagnosis"
    : project.id === "qingyang-east-data-west"
      ? "Qingyang East Data West Cost Analysis"
      : title;
const summary = data.summaryEn ?? data.summary;
const highlights = data.highlightsEn ?? data.highlights;
const metrics = data.metricsEn ?? data.metrics;
const alternates = {
  zh: `${base}projects/${project.id}/`,
  en: `${base}en/projects/${project.id}/`,
};
---

<BaseLayout
  title={seoTitle}
  description={summary}
  image={`/og/${project.id}.jpg`}
  lang="en"
  alternates={alternates}
>
  <JsonLd data={projectJsonLd(project, `projects/${project.id}/`)} />
  <JsonLd
    data={breadcrumbJsonLd([
      { name: "Home", path: "/en/" },
      { name: "Projects", path: "/en/projects/" },
      { name: title, path: `en/projects/${project.id}/` },
    ])}
  />

  <nav class="crumbs" aria-label="Breadcrumb">
    <ol>
      <li>
        <a href={`${base}en/`}>Home</a>
      </li>
      <li>
        <a href={`${base}en/projects/`}>Projects</a>
      </li>
      <li aria-current="page">{title}</li>
    </ol>
  </nav>

  <article>
    <header class="head">
      <p class="mono-label">{domain.labelEn ?? domain.label}</p>
      <div class="title-row">
        <h1>{title}</h1>
        <div class="title-actions">
          {data.links.repo && <RepoLink repo={data.links.repo} title={title} lang="en" compact />}
          {data.links.demo && (
            <a class="demo-link" href={data.links.demo} target="_blank" rel="noopener noreferrer">
              Demo ↗
            </a>
          )}
        </div>
      </div>
      <p class="summary">{summary}</p>
      <dl class="meta">
        <div>
          <dt>Role</dt>
          <dd>{data.roleEn ?? data.role}</dd>
        </div>
        <div>
          <dt>Period</dt>
          <dd>{period}</dd>
        </div>
        <div>
          <dt>Status</dt>
          <dd>{statusLabel}</dd>
        </div>
        {data.teamEn && (
          <div>
            <dt>Team</dt>
            <dd>{data.teamEn}</dd>
          </div>
        )}
      </dl>
    </header>

    {(data.cover || cover) && (
      <figure
        class="cover"
        style={
          !data.cover && lqip
            ? `background-image:url("${lqip}");background-size:cover;background-position:center`
            : undefined
        }
      >
        {data.cover ? (
          <ProjectMedia src={data.cover.src} alt={`${title} cover`} loading="eager" />
        ) : (
          cover && (
            <Picture
              src={cover.default}
              formats={["avif", "webp"]}
              widths={[640, 960, 1280, 1600]}
              sizes="(max-width: 960px) 100vw, 896px"
              alt={`${title} cover`}
              loading="lazy"
              decoding="async"
            />
          )
        )}
      </figure>
    )}

    <div class="layout">
      <div class="prose">
        <Content />
        <section class="boundary" aria-labelledby="boundary-title">
          <h2 id="boundary-title">Scope and security</h2>
          <p>
            This is a static case study. The page does not run project code or collect uploads,
            logins or visitor data. Metrics come from project records and local experiments;
            reproduce details from the source or report.
            <a href={`${base}en/security/`}>Read the site security model →</a>
          </p>
        </section>
      </div>
      <aside class="side" aria-label="Project information">
        <Toc headings={headings} />
        <section>
          <h2>Stack</h2>
          <ul class="stack">
            {data.stack.map((item) => (
              <li>
                <Badge tone="outline">{item}</Badge>
              </li>
            ))}
          </ul>
        </section>
        {highlights.length > 0 && (
          <section>
            <h2>Highlights</h2>
            <ul class="highlights">
              {highlights.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </section>
        )}
        {metrics.length > 0 && (
          <section>
            <h2>Metrics</h2>
            <dl class="metrics">
              {metrics.map((metric) => (
                <div>
                  <dt>{metric.label}</dt>
                  <dd>
                    {metric.value}
                    {metric.unit ? <span>{metric.unit}</span> : null}
                  </dd>
                </div>
              ))}
            </dl>
          </section>
        )}
        {(data.links.repo || data.links.demo || data.links.paper || data.links.doc) && (
          <section>
            <h2>Links</h2>
            <ul class="links">
              {data.links.repo && (
                <li>
                  <a href={data.links.repo}>Source</a>
                </li>
              )}
              {data.links.demo && (
                <li>
                  <a href={data.links.demo}>Demo</a>
                </li>
              )}
              {data.links.paper && (
                <li>
                  <a href={data.links.paper}>Paper / report</a>
                </li>
              )}
              {data.links.doc && (
                <li>
                  <a href={data.links.doc}>Documentation</a>
                </li>
              )}
            </ul>
          </section>
        )}
      </aside>
    </div>
  </article>

  <Gallery images={galleryImages} />

  {related.length > 0 && (
    <section class="related" aria-labelledby="related-title">
      <h2 id="related-title">Related projects</h2>
      <ul class="related-grid">
        {related.map((item, index) => (
          <li>
            <ProjectCard project={item} index={index + 1} lang="en" />
          </li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>

<style>
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0 0 2rem;
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .crumbs li:not(:last-child)::after {
    content: "/";
    margin-left: 0.5rem;
    color: var(--border-strong);
  }
  .crumbs a {
    text-decoration: none;
  }
  .head {
    max-width: 58rem;
  }
  .title-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }
  .title-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding-top: 0.7rem;
  }
  h1 {
    margin: 0.5rem 0 1rem;
    font-size: clamp(2rem, 5vw, 3.5rem);
    letter-spacing: -0.035em;
    line-height: 1.08;
  }
  .summary {
    margin: 0;
    color: var(--muted);
    font-size: clamp(1.05rem, 1.9vw, 1.25rem);
    max-width: 46rem;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    margin: 1.5rem 0 0;
  }
  .meta dt {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .meta dd {
    margin: 0.15rem 0 0;
    font-size: 0.875rem;
  }
  .cover {
    margin: clamp(2rem, 4vw, 2.75rem) 0 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background-color: var(--surface);
    background-size: cover;
    background-position: center;
  }
  .cover :global(img),
  .prose :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .layout {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    grid-template-columns: minmax(0, 1fr) 16rem;
    margin-top: clamp(2.5rem, 6vw, 4rem);
    align-items: start;
  }
  .side {
    position: sticky;
    top: 5.5rem;
    display: grid;
    gap: 1.75rem;
  }
  .side h2 {
    margin: 0 0 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 500;
  }
  .stack,
  .links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .links {
    display: grid;
    gap: 0.35rem;
  }
  .highlights {
    list-style: none;
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    font-size: 0.875rem;
    color: var(--muted);
  }
  .highlights li {
    padding-left: 0.8rem;
    border-left: 2px solid var(--accent);
  }
  .metrics {
    display: grid;
    gap: 0.65rem;
    margin: 0;
  }
  .metrics dt {
    color: var(--muted);
    font-size: 0.72rem;
  }
  .metrics dd {
    margin: 0.1rem 0 0;
    font-size: 1.15rem;
  }
  .metrics span {
    margin-left: 0.25rem;
    color: var(--muted);
    font-size: 0.72rem;
  }
  .boundary {
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
  }
  .boundary h2 {
    font-size: 1.05rem;
  }
  .boundary p {
    color: var(--muted);
    font-size: 0.9rem;
  }
  .related {
    margin-top: clamp(3rem, 7vw, 5rem);
  }
  .related-grid {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 26rem), 1fr));
  }
  @media (max-width: 900px) {
    .layout {
      grid-template-columns: 1fr;
    }
    .side {
      position: static;
      order: -1;
    }
    .title-row {
      flex-direction: column;
    }
    .title-actions {
      padding-top: 0;
    }
  }
</style>
