---
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { Lang } from "@/i18n";

interface Props {
  lang?: Lang;
}

const { lang = "zh" } = Astro.props;
const base = import.meta.env.BASE_URL;
const copy =
  lang === "en"
    ? {
        kicker: "Subscribe / Feed",
        title: "Subscribe",
        lead: "RSS is a machine-readable feed, not a web page. Opening the XML source directly is normal; add the URL to a feed reader instead.",
        rss: "RSS feed",
        json: "JSON Feed",
        whyTitle: "Why keep RSS",
        why: [
          "Readers can subscribe without an account or email address.",
          "The feed contains the same public projects and notes as the site.",
          "Bots and scripts can consume the same URL without scraping HTML.",
        ],
        howTitle: "How to subscribe",
        how: [
          "Copy the RSS URL below.",
          "Add it to Feedly, Inoreader, NetNewsWire, Reeder or another feed reader.",
          "The reader polls for new items; no newsletter or tracking is involved.",
        ],
        rawNote:
          "The raw XML page is the feed itself. Keep it for readers; this page is only the human-friendly entry.",
        back: "Back to home",
      }
    : {
        kicker: "订阅 / Feed",
        title: "订阅",
        lead: "RSS 是给阅读器消费的机器格式，不是网页。浏览器直接打开 XML 是正常现象；把地址加入阅读器即可。",
        rss: "RSS 订阅源",
        json: "JSON Feed",
        whyTitle: "为什么保留 RSS",
        why: [
          "读者无需账号或邮箱即可订阅。",
          "Feed 内容与站点公开的项目、笔记一致。",
          "脚本和 Bot 可以直接消费同一个地址，不需要抓 HTML。",
        ],
        howTitle: "如何使用",
        how: [
          "复制下面的 RSS 地址。",
          "加入 Feedly、Inoreader、NetNewsWire、Reeder 等阅读器。",
          "阅读器会定期拉取新内容；没有邮件订阅，也没有追踪。",
        ],
        rawNote:
          "直接打开 XML 看到源码树是正常的；这个页面只是给人的订阅说明，rss.xml 仍然保留给阅读器。",
        back: "返回首页",
      };
---

<BaseLayout title={copy.title} description={copy.lead} lang={lang}>
  <header class="page-head">
    <p class="mono-label">{copy.kicker}</p>
    <h1>{copy.title}</h1>
    <p class="lead">{copy.lead}</p>
  </header>

  <section class="feed-links" aria-label={copy.rss}>
    <a class="feed-card" href={`${base}rss.xml`}>
      <span class="mono-label">RSS 2.0</span>
      <strong>{copy.rss}</strong>
      <code>{`${base}rss.xml`}</code>
      <span class="arrow">打开 XML ↗</span>
    </a>
    <a class="feed-card" href={`${base}feed.json`}>
      <span class="mono-label">JSON Feed 1.1</span>
      <strong>{copy.json}</strong>
      <code>{`${base}feed.json`}</code>
      <span class="arrow">打开 JSON ↗</span>
    </a>
  </section>

  <section class="section" aria-labelledby="why-title">
    <h2 id="why-title">{copy.whyTitle}</h2>
    <ul class="list">
      {copy.why.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
  </section>

  <section class="section" aria-labelledby="how-title">
    <h2 id="how-title">{copy.howTitle}</h2>
    <ol class="list">
      {copy.how.map((item) => (
        <li>{item}</li>
      ))}
    </ol>
    <p class="raw-note">{copy.rawNote}</p>
  </section>

  <p class="back">
    <a href={base}>{copy.back} →</a>
  </p>
</BaseLayout>

<style>
  .page-head {
    max-width: 48rem;
    margin-bottom: clamp(2rem, 5vw, 3rem);
  }

  h1 {
    margin: 0.5rem 0 0.9rem;
    font-size: clamp(2.4rem, 6vw, 4.4rem);
    letter-spacing: -0.045em;
  }

  .lead {
    margin: 0;
    color: var(--muted);
  }

  .feed-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: 1rem;
    max-width: 56rem;
  }

  .feed-card {
    display: grid;
    gap: 0.45rem;
    padding: 1.1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface-raised);
    text-decoration: none;
  }

  .feed-card strong {
    font-size: 1.1rem;
  }

  .feed-card code {
    color: var(--muted);
    font-size: 0.78rem;
    overflow-wrap: anywhere;
  }

  .arrow {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .section {
    max-width: 48rem;
    margin-top: clamp(2.5rem, 6vw, 4rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .section h2 {
    margin: 0 0 1rem;
    font-size: 1.25rem;
  }

  .list {
    display: grid;
    gap: 0.6rem;
    margin: 0;
    padding-left: 1.2rem;
    color: var(--muted);
  }

  .raw-note {
    margin: 1rem 0 0;
    color: var(--muted);
    font-size: 0.85rem;
  }

  .back {
    margin-top: 2rem;
    font-size: 0.875rem;
  }
</style>
