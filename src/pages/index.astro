---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Button from "@/components/ui/Button.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import ProjectCard from "@/components/project/ProjectCard.astro";
import { profile } from "@/data/profile";
import { profileEn } from "@/data/profile.en";
import { getPublishedProjects } from "@/lib/content";
import { getPublishedNotes } from "@/lib/notes";
import { DOMAIN_LIST, getDomainMeta } from "@/data/domains";
import JsonLd from "@/components/seo/JsonLd.astro";
import { personJsonLd, websiteJsonLd } from "@/lib/jsonld";
import { copy, format, ui, type Lang } from "@/i18n";
import { localizePath } from "@/i18n/routing";

interface Props {
  lang?: Lang;
}

const { lang = "zh" } = Astro.props;
const t = ui[lang];
const c = copy[lang].home;
const person = lang === "en" ? profileEn : profile;
const projects = await getPublishedProjects();
const notes = (await getPublishedNotes()).slice(0, 3);
const featured = projects.slice(0, 3);
const counts = new Map<string, number>();
for (const project of projects) {
  counts.set(project.data.domain, (counts.get(project.data.domain) ?? 0) + 1);
}
const domainCount = counts.size;
const projectsHref = localizePath("projects/", lang);
const notesHref = localizePath("notes/", lang);
const nowHref = localizePath("now/", lang);
const aboutHref = localizePath("about/", lang);
---

<BaseLayout title={`${person.name} — ${person.role}`} description={person.tagline} lang={lang}>
  <JsonLd data={personJsonLd()} />
  <JsonLd data={websiteJsonLd()} />

  <section class="hero" aria-labelledby="hero-title">
    <p class="kicker">
      <span class="dot" aria-hidden="true"></span>
      {person.availability}
      <span class="sep" aria-hidden="true">
        ·
      </span>
      <span data-local-time data-timezone={person.timezone}>
        UTC+8
      </span>
    </p>
    <h1 id="hero-title">
      <span class="name">{person.name}</span>
      <span class="en" lang={lang === "en" ? "zh-CN" : "en"}>
        {person.nameEn}
      </span>
    </h1>
    <p class="statement">{person.statement}</p>
    <p class="bio-short">{person.bioShort}</p>
    <details class="bio-more">
      <summary>{c.fullBio}</summary>
      <p>{person.bio}</p>
    </details>
    <div class="cta">
      <Button href={projectsHref} size="lg">
        {c.viewProjects}
      </Button>
      <Button href={nowHref} variant="secondary" size="lg">
        {c.now}
      </Button>
      <Button href={aboutHref} variant="ghost" size="lg">
        {c.about}
      </Button>
    </div>
    <dl class="facts">
      <div>
        <dt>{c.facts.projects}</dt>
        <dd>
          {projects.length}
          <span>{c.facts.cases}</span>
        </dd>
      </div>
      <div>
        <dt>{c.facts.domains}</dt>
        <dd>
          {domainCount}
          <span>{c.facts.directions}</span>
        </dd>
      </div>
      <div>
        <dt>{c.facts.location}</dt>
        <dd>{person.location}</dd>
      </div>
      <div>
        <dt>{c.facts.contact}</dt>
        <dd>
          <a href={`mailto:${person.email}`}>{person.email}</a>
        </dd>
      </div>
    </dl>
  </section>

  <section class="section" aria-labelledby="work-title">
    <SectionHeading
      id="work-title"
      index={c.work.index}
      title={c.work.title}
      description={c.work.description}
    />
    <ul class="grid">
      {featured.map((project, index) => (
        <li>
          <ProjectCard project={project} index={index + 1} lang={lang} />
        </li>
      ))}
    </ul>
    <p class="more">
      <a href={projectsHref}>{format(c.work.more, { count: projects.length })}</a>
    </p>
    {lang === "en" && <p class="notice">{t.common.caseNote}</p>}
  </section>

  <section class="section" aria-labelledby="domains-title">
    <SectionHeading
      id="domains-title"
      index={c.domains.index}
      title={c.domains.title}
      description={c.domains.description}
    />
    <ul class="domains">
      {DOMAIN_LIST.map((domain, index) => {
        const meta = getDomainMeta(domain.id, lang);
        return (
          <li>
            <a href={`${projectsHref}?domain=${domain.id}`}>
              <span class="idx">{String(index + 1).padStart(2, "0")}</span>
              <span class="domain-body">
                <span class="domain-label">{meta.label}</span>
                <span class="domain-desc">{meta.description}</span>
              </span>
              <span class="count">{counts.get(domain.id) ?? "—"}</span>
            </a>
          </li>
        );
      })}
    </ul>
  </section>

  {notes.length > 0 && (
    <section class="section" aria-labelledby="notes-title">
      <SectionHeading
        id="notes-title"
        index={c.notes.index}
        title={c.notes.title}
        description={c.notes.description}
      />
      <ul class="notes">
        {notes.map((note) => (
          <li>
            <a href={`${import.meta.env.BASE_URL}notes/${note.id}/`}>
              <span class="note-date">{note.data.date}</span>
              <span class="note-body">
                <span
                  class="note-title"
                  lang={lang === "en" && !note.data.titleEn ? "zh-CN" : undefined}
                >
                  {lang === "en" ? (note.data.titleEn ?? note.data.title) : note.data.title}
                </span>
                <span
                  class="note-summary"
                  lang={lang === "en" && !note.data.titleEn ? "zh-CN" : undefined}
                >
                  {lang === "en" ? (note.data.summaryEn ?? note.data.summary) : note.data.summary}
                </span>
              </span>
              <span class="note-arrow" aria-hidden="true">
                →
              </span>
            </a>
          </li>
        ))}
      </ul>
      <p class="more">
        <a href={notesHref}>{c.notes.more}</a>
      </p>
    </section>
  )}

  <section class="contact" aria-labelledby="contact-title">
    <p class="mono-label">
      {c.contact.index} / {c.contact.kicker}
    </p>
    <h2 id="contact-title">{c.contact.title}</h2>
    <p>{c.contact.description}</p>
    <div class="contact-actions">
      <Button href={`mailto:${person.email}`} size="lg">
        {c.contact.send}
      </Button>
      <Button href={aboutHref} variant="ghost" size="lg">
        {c.contact.more}
      </Button>
    </div>
  </section>
</BaseLayout>

<script>
  function updateLocalTime(): void {
    document.querySelectorAll<HTMLElement>("[data-local-time]").forEach((element) => {
      const timezone = element.dataset.timezone || "Asia/Shanghai";
      const isEnglish = document.documentElement.dataset.lang === "en";
      const time = new Intl.DateTimeFormat(isEnglish ? "en-US" : "zh-CN", {
        timeZone: timezone,
        hour: "2-digit",
        minute: "2-digit",
        hour12: false,
      }).format(new Date());
      // 只替换等宽的时间文本，避免加载后改变文案长度造成布局偏移。
      element.textContent = time;
      element.setAttribute("aria-label", isEnglish ? "Local time" : "本地时间");
      element.title = isEnglish ? "Local time" : "本地时间";
    });
  }

  document.addEventListener("astro:page-load", updateLocalTime);
</script>

<style>
  .hero {
    padding-block: clamp(1rem, 4vw, 3rem) clamp(2rem, 5vw, 4rem);
    max-width: 60rem;
  }

  .kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 1.75rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: var(--muted);
    text-transform: uppercase;
  }

  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  h1 {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem 1.25rem;
    letter-spacing: -0.045em;
  }

  .name {
    font-size: clamp(2.75rem, 9vw, 6.5rem);
    font-weight: 600;
    line-height: 0.98;
  }

  .en {
    font-family: var(--font-mono);
    font-size: clamp(0.8rem, 1.4vw, 1rem);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .statement {
    margin: 1.5rem 0 0;
    max-width: 34rem;
    font-size: clamp(1.5rem, 3.4vw, 2.4rem);
    line-height: 1.28;
    letter-spacing: -0.02em;
  }

  .bio-short {
    margin: 0.9rem 0 0;
    max-width: 36rem;
    color: var(--muted);
  }

  .bio-more {
    margin-top: 0.6rem;
    max-width: 36rem;
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .bio-more summary {
    cursor: pointer;
    color: var(--fg);
    font-size: 0.875rem;
  }

  .bio-more p {
    margin: 0.5rem 0 0;
  }

  .sep {
    color: var(--border-strong);
  }

  [data-local-time] {
    font-variant-numeric: tabular-nums;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 1.5rem;
    margin: clamp(3rem, 7vw, 5rem) 0 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .facts dt {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .facts dd {
    margin: 0.4rem 0 0;
    font-size: 1.05rem;
    overflow-wrap: anywhere;
  }

  .facts dd span {
    margin-left: 0.3rem;
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .facts a {
    text-decoration: none;
    border-bottom: 1px solid var(--border-strong);
  }

  .section {
    margin-top: clamp(4rem, 10vw, 7.5rem);
  }

  .grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
  }

  .grid > li {
    display: flex;
  }

  .grid > li > :global(*) {
    width: 100%;
  }

  .more {
    margin-top: 1.5rem;
  }

  .more a {
    font-size: 0.9375rem;
    text-decoration: none;
    border-bottom: 1px solid var(--border-strong);
  }

  .notice {
    margin: 0.75rem 0 0;
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .domains {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--border);
  }

  .domains li {
    border-bottom: 1px solid var(--border);
  }

  .domains a {
    display: grid;
    grid-template-columns: 3rem 1fr auto;
    gap: 1rem;
    align-items: center;
    padding-block: 1rem;
    text-decoration: none;
  }

  .domains a:hover .domain-label {
    color: var(--accent);
  }

  .idx,
  .count {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
  }

  .domain-body {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.9rem;
  }

  .domain-label {
    font-size: 1.05rem;
  }

  .domain-desc {
    font-size: 0.875rem;
    color: var(--muted);
  }

  .skills {
    display: grid;
    gap: 2rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
  }

  .skill-group h3 {
    margin: 0 0 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 500;
  }

  .skill-group p {
    margin: 0;
    color: var(--fg);
    font-size: 0.9375rem;
    line-height: 1.8;
  }

  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border);
  }

  .timeline li {
    display: grid;
    grid-template-columns: 10rem 1fr auto;
    gap: 1rem;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--border);
    align-items: baseline;
  }

  .period {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
  }

  .timeline h3 {
    margin: 0;
    font-size: 1.05rem;
  }

  .org {
    margin: 0.2rem 0 0;
    font-size: 0.875rem;
    color: var(--accent);
  }

  .detail {
    margin: 0.45rem 0 0;
    font-size: 0.875rem;
    color: var(--muted);
    max-width: 44rem;
  }

  .kind {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--muted);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.15rem 0.55rem;
  }

  .notes {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border);
  }

  .notes li {
    border-bottom: 1px solid var(--border);
  }

  .notes a {
    display: grid;
    grid-template-columns: 7rem 1fr auto;
    gap: 1rem;
    align-items: start;
    padding-block: 1rem;
    text-decoration: none;
  }

  .note-date {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--muted);
  }

  .note-body {
    display: grid;
    gap: 0.3rem;
  }

  .note-title {
    font-size: 1.05rem;
    font-weight: 600;
  }

  .notes a:hover .note-title {
    color: var(--accent);
  }

  .note-summary {
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.7;
  }

  .note-arrow {
    color: var(--muted);
    transition: transform var(--dur-2) var(--ease-out);
  }

  .notes a:hover .note-arrow {
    transform: translateX(4px);
    color: var(--accent);
  }

  .contact {
    margin-top: clamp(5rem, 12vw, 9rem);
    padding-top: 2.5rem;
    border-top: 1px solid var(--border);
  }

  .contact h2 {
    margin: 0.5rem 0 0.75rem;
    font-size: clamp(1.6rem, 3.6vw, 2.6rem);
    letter-spacing: -0.03em;
    max-width: 40rem;
  }

  .contact p {
    margin: 0;
    color: var(--muted);
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  @media (max-width: 1023px) {
    .facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .facts > div:last-child {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 767px) {
    .timeline li {
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }

    .kind {
      justify-self: start;
    }
  }
</style>
