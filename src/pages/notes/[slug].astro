---
import { render } from "astro:content";
import NoteDetail from "@/components/note/NoteDetail.astro";
import { getPublishedNotes } from "@/lib/notes";

export async function getStaticPaths() {
  const notes = await getPublishedNotes();
  return notes.map((note) => ({ params: { slug: note.id }, props: { note } }));
}

const { note } = Astro.props;
const { Content, headings } = await render(note);
---

<NoteDetail note={note} Content={Content} headings={headings} lang="zh" />
