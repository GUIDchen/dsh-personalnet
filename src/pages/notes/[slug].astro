---
import { render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Toc from "@/components/project/Toc.astro";
import JsonLd from "@/components/seo/JsonLd.astro";
import {
  getPublishedNotes,
  getRelatedNotes,
  getAdjacentNotes,
  estimateReadingTime,
} from "@/lib/notes";
import { breadcrumbJsonLd, noteJsonLd } from "@/lib/jsonld";

export async function getStaticPaths() {
  const notes = await getPublishedNotes();
  return notes.map((note) => ({ params: { slug: note.id }, props: { note } }));
}

const { note } = Astro.props;
const { Content, headings } = await render(note);
const notes = await getPublishedNotes();
const related = getRelatedNotes(note, notes, 3);
const adjacent = getAdjacentNotes(note, notes);
const readingTime = estimateReadingTime(note.body ?? "");
const base = import.meta.env.BASE_URL;
---

<BaseLayout title={note.data.title} description={note.data.summary}>
  <JsonLd data={noteJsonLd(note, `notes/${note.id}/`)} />
  <JsonLd
    data={breadcrumbJsonLd([
      { name: "首页", path: "/" },
      { name: "笔记", path: "/notes/" },
      { name: note.data.title, path: `notes/${note.id}/` },
    ])}
  />

  <nav class="crumbs" aria-label="面包屑">
    <ol>
      <li>
        <a href={base}>首页</a>
      </li>
      <li>
        <a href={`${base}notes/`}>笔记</a>
      </li>
      <li aria-current="page">{note.data.title}</li>
    </ol>
  </nav>

  <article>
    <header class="head">
      <p class="mono-label">笔记 / {note.data.date}</p>
      <h1>{note.data.title}</h1>
      <p class="summary">{note.data.summary}</p>
      <div class="meta">
        <span>{readingTime} 分钟阅读</span>
        {note.data.tags.map((tag) => (
          <span class="tag">{tag}</span>
        ))}
      </div>
    </header>

    <div class="layout">
      <div class="prose">
        <Content />
      </div>
      <aside class="side" aria-label="笔记信息">
        <Toc headings={headings} />
      </aside>
    </div>
  </article>

  <nav class="adjacent" aria-label="笔记导航">
    {adjacent.prev ? (
      <a href={`${base}notes/${adjacent.prev.id}/`}>
        <span class="mono-label">上一篇</span>
        <span>{adjacent.prev.data.title}</span>
      </a>
    ) : (
      <span />
    )}
    {adjacent.next ? (
      <a class="next" href={`${base}notes/${adjacent.next.id}/`}>
        <span class="mono-label">下一篇</span>
        <span>{adjacent.next.data.title}</span>
      </a>
    ) : (
      <span />
    )}
  </nav>

  {related.length > 0 && (
    <section class="related" aria-labelledby="related-title">
      <h2 id="related-title">相关笔记</h2>
      <ul>
        {related.map((item) => (
          <li>
            <a href={`${base}notes/${item.id}/`}>
              <span class="mono-label">{item.data.date}</span>
              <span>{item.data.title}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>

<style>
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0 0 2rem;
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .crumbs li:not(:last-child)::after {
    content: "/";
    margin-left: 0.5rem;
    color: var(--border-strong);
  }

  .crumbs a {
    text-decoration: none;
  }

  .head {
    max-width: 52rem;
  }

  h1 {
    margin: 0.5rem 0 1rem;
    font-size: clamp(2rem, 5vw, 3.25rem);
    letter-spacing: -0.035em;
    line-height: 1.1;
  }

  .summary {
    margin: 0;
    font-size: clamp(1.05rem, 1.9vw, 1.25rem);
    color: var(--muted);
    max-width: 46rem;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    margin-top: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--muted);
  }

  .tag {
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.1rem 0.5rem;
  }

  .layout {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    grid-template-columns: minmax(0, 1fr) 15rem;
    margin-top: clamp(2.5rem, 6vw, 3.5rem);
    align-items: start;
  }

  .side {
    position: sticky;
    top: 5.5rem;
    border-left: 1px solid var(--border);
    padding-left: 1.5rem;
  }

  .adjacent {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: clamp(3rem, 7vw, 5rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .adjacent a {
    display: grid;
    gap: 0.35rem;
    text-decoration: none;
  }

  .adjacent a:hover span:last-child {
    color: var(--accent);
  }

  .adjacent .next {
    text-align: right;
  }

  .related {
    margin-top: clamp(3rem, 7vw, 5rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .related h2 {
    margin: 0 0 1rem;
    font-size: clamp(1.2rem, 2.2vw, 1.5rem);
  }

  .related ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }

  .related a {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
    text-decoration: none;
  }

  .related a:hover span:last-child {
    color: var(--accent);
  }

  @media (max-width: 959px) {
    .layout {
      grid-template-columns: 1fr;
    }

    .side {
      position: static;
      border-left: 0;
      border-top: 1px solid var(--border);
      padding-left: 0;
      padding-top: 1.5rem;
    }
  }
</style>
