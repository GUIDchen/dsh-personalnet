---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProjectCard from "@/components/project/ProjectCard.astro";
import { getPublishedProjects } from "@/lib/content";
import { DOMAIN_LIST } from "@/data/domains";

const projects = await getPublishedProjects();
const counts = new Map<string, number>();
for (const project of projects) {
  counts.set(project.data.domain, (counts.get(project.data.domain) ?? 0) + 1);
}
const domainCount = counts.size;
---

<BaseLayout
  title="项目"
  description={`共 ${projects.length} 个项目案例，覆盖 ${domainCount} 个领域。`}
>
  <header class="page-head">
    <p class="mono-label">索引 / 项目</p>
    <h1>项目</h1>
    <p class="lead">
      {projects.length} 个案例，覆盖 {domainCount}{" "}
      个领域。按精选与时间排序，每个案例都写清了问题、约束、方案与结果。
    </p>
  </header>

  <nav class="chips" aria-label="按领域筛选">
    <a class="chip is-active" href={`${import.meta.env.BASE_URL}projects/`}>
      全部 <span>{projects.length}</span>
    </a>
    {DOMAIN_LIST.filter((domain) => (counts.get(domain.id) ?? 0) > 0).map((domain) => (
      <a
        class="chip"
        href={`${import.meta.env.BASE_URL}projects/?domain=${domain.id}`}
        data-filter-domain={domain.id}
      >
        {domain.label} <span>{counts.get(domain.id)}</span>
      </a>
    ))}
  </nav>

  <ul class="project-grid">
    {projects.map((project, index) => (
      <li>
        <ProjectCard project={project} index={index + 1} />
      </li>
    ))}
  </ul>
</BaseLayout>

<style>
  .page-head {
    max-width: 44rem;
    margin-bottom: clamp(2rem, 5vw, 3rem);
  }

  h1 {
    margin: 0.5rem 0 0.75rem;
    font-size: clamp(2.25rem, 6vw, 4rem);
    letter-spacing: -0.04em;
  }

  .lead {
    margin: 0;
    color: var(--muted);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-block: 1rem;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    margin-bottom: clamp(2rem, 5vw, 3rem);
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.35rem 0.8rem;
    font-size: 0.8125rem;
    text-decoration: none;
    color: var(--muted);
  }

  .chip span {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--muted);
  }

  .chip:hover {
    border-color: var(--border-strong);
    color: var(--fg);
  }

  .chip.is-active {
    background: var(--fg);
    border-color: var(--fg);
    color: var(--bg);
  }

  .chip.is-active span {
    color: var(--bg);
  }

  .project-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
  }

  .project-grid > li {
    display: flex;
  }

  .project-grid > li > :global(*) {
    width: 100%;
  }
</style>
