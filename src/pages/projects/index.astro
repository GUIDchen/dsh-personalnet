---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProjectCard from "@/components/project/ProjectCard.astro";
import { getPublishedProjects } from "@/lib/content";
import { DOMAIN_LIST } from "@/data/domains";
import { getFacets } from "@/lib/filter";
import { breadcrumbJsonLd } from "@/lib/jsonld";
import { TAG_VOCABULARY } from "@/data/tags";
import JsonLd from "@/components/seo/JsonLd.astro";
import { copy, format, ui, type Lang } from "@/i18n";
import { localizePath } from "@/i18n/routing";
import { getDomainMeta } from "@/data/domains";

interface Props {
  lang?: Lang;
}

const { lang = "zh" } = Astro.props;
const t = ui[lang];
const c = copy[lang].projects;
const projects = await getPublishedProjects();
const counts = new Map<string, number>();
for (const project of projects) {
  counts.set(project.data.domain, (counts.get(project.data.domain) ?? 0) + 1);
}
const domainCount = counts.size;

// 标签按使用次数排序，次数相同则按词表顺序，保证首屏展示的是有意义的标签。
const tagCounts = getFacets(projects).tags;
const tagCountMap = new Map(tagCounts.map((tag) => [tag.id, tag.count]));
const topTags = TAG_VOCABULARY.filter((tag) => tagCountMap.has(tag))
  .sort((a, b) => {
    const diff = (tagCountMap.get(b) ?? 0) - (tagCountMap.get(a) ?? 0);
    return diff !== 0 ? diff : TAG_VOCABULARY.indexOf(a) - TAG_VOCABULARY.indexOf(b);
  })
  .slice(0, 12)
  .map((id) => ({ id, count: tagCountMap.get(id) ?? 0 }));
---

<BaseLayout
  title={c.title}
  description={
    lang === "en"
      ? `${projects.length} case studies across ${domainCount} domains.`
      : `共 ${projects.length} 个项目案例，覆盖 ${domainCount} 个领域。`
  }
  lang={lang}
>
  <JsonLd
    data={breadcrumbJsonLd([
      { name: t.nav.home, path: localizePath("", lang) },
      { name: t.nav.projects, path: localizePath("projects/", lang) },
    ])}
  />

  <header class="page-head">
    <p class="mono-label">{c.kicker}</p>
    <h1>{c.title}</h1>
    <p class="lead">{format(c.lead, { count: projects.length, domains: domainCount })}</p>
    <p class="github-link">
      <a href={localizePath("github/", lang)}>
        {lang === "en" ? "GitHub projects" : "GitHub 项目"} →
      </a>
    </p>
  </header>

  <div data-projects-root>
    <div class="toolbar" data-filter-bar>
      <div
        class="chip-row"
        role="group"
        aria-label={lang === "en" ? "Filter by domain" : "按领域筛选"}
      >
        <button type="button" class="chip" data-filter-domain="" aria-pressed="true">
          {c.all} <span>{projects.length}</span>
        </button>
        {DOMAIN_LIST.filter((domain) => (counts.get(domain.id) ?? 0) > 0).map((domain) => (
          <button type="button" class="chip" data-filter-domain={domain.id} aria-pressed="false">
            {getDomainMeta(domain.id, lang).label} <span>{counts.get(domain.id)}</span>
          </button>
        ))}
      </div>

      <div class="tag-row" role="group" aria-label={lang === "en" ? "Filter by tag" : "按标签筛选"}>
        <span class="mono-label">{c.tags}</span>
        {topTags.map((tag) => (
          <button type="button" class="tag-chip" data-filter-tag={tag.id} aria-pressed="false">
            {tag.id} <span>{tag.count}</span>
          </button>
        ))}
      </div>

      <div class="toolbar-end">
        <button type="button" class="link-button" data-clear-filters>
          {c.clear}
        </button>
        <label class="sort">
          <span class="mono-label">{c.sort}</span>
          <select data-sort>
            <option value="featured">{c.sortFeatured}</option>
            <option value="latest">{c.sortLatest}</option>
            <option value="title">{c.sortTitle}</option>
          </select>
        </label>
      </div>
    </div>

    <p class="result" aria-live="polite">
      {lang === "en" ? "Showing " : "显示 "}
      <span data-visible-count>{projects.length}</span>
      {lang === "en" ? ` / ${projects.length} projects` : ` / ${projects.length} 个项目`}
    </p>

    <ul class="project-grid" data-project-grid>
      {projects.map((project, index) => (
        <li
          data-project-item
          data-domain={project.data.domain}
          data-tags={project.data.tags.join(" ")}
          data-title={project.data.title}
          data-start={project.data.timeframe.start}
          data-featured={String(project.data.featured)}
          data-order={String(project.data.order)}
        >
          <ProjectCard project={project} index={index + 1} level={2} lang={lang} />
        </li>
      ))}
    </ul>

    <div class="empty" data-empty-state hidden>
      <p class="empty-title">{c.emptyTitle}</p>
      <p class="empty-desc">{c.emptyDesc}</p>
      <button type="button" class="chip" data-clear-filters>
        {c.clear}
      </button>
    </div>
  </div>

  <noscript>
    <p class="notice">{c.noJs}</p>
  </noscript>

  {lang === "en" && <p class="notice">{c.notice}</p>}
</BaseLayout>

<script>
  import { initProjectFilters } from "@/scripts/projects-filter";
  document.addEventListener("astro:page-load", initProjectFilters);
</script>

<style>
  .page-head {
    max-width: 44rem;
    margin-bottom: clamp(2rem, 5vw, 3rem);
  }

  .github-link {
    margin: 1rem 0 0;
    font-size: 0.875rem;
  }

  h1 {
    margin: 0.5rem 0 0.75rem;
    font-size: clamp(2.25rem, 6vw, 4rem);
    letter-spacing: -0.04em;
  }

  .lead {
    margin: 0;
    color: var(--muted);
  }

  .toolbar {
    display: grid;
    gap: 0.9rem;
    padding-block: 1rem;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    margin-bottom: 1rem;
  }

  .chip-row,
  .tag-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .chip,
  .tag-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.35rem 0.8rem;
    font: inherit;
    font-size: 0.8125rem;
    color: var(--muted);
    background: transparent;
    cursor: pointer;
    min-height: 36px;
  }

  .tag-chip {
    padding: 0.2rem 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    min-height: 30px;
  }

  .chip span,
  .tag-chip span {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--muted);
  }

  .chip:hover,
  .tag-chip:hover {
    border-color: var(--border-strong);
    color: var(--fg);
  }

  .chip[aria-pressed="true"],
  .tag-chip[aria-pressed="true"] {
    background: var(--fg);
    border-color: var(--fg);
    color: var(--bg);
  }

  .chip[aria-pressed="true"] span,
  .tag-chip[aria-pressed="true"] span {
    color: var(--bg);
  }

  .toolbar-end {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .link-button {
    border: 0;
    background: transparent;
    color: var(--muted);
    font-size: 0.8125rem;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    cursor: pointer;
    padding: 0.25rem 0;
  }

  .link-button:hover {
    color: var(--fg);
  }

  .sort {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  select {
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg);
    color: var(--fg);
    padding: 0.35rem 0.6rem;
    font: inherit;
    font-size: 0.8125rem;
  }

  .result {
    margin: 0 0 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
  }

  .project-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 26rem), 1fr));
  }

  .project-grid > li {
    display: flex;
  }

  .project-grid > li > :global(*) {
    width: 100%;
  }

  .empty {
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-lg);
    padding: 2.5rem 1.5rem;
    text-align: center;
  }

  .empty-title {
    margin: 0;
    font-weight: 600;
  }

  .empty-desc {
    margin: 0.35rem 0 1.25rem;
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .notice {
    margin-top: 1.5rem;
    color: var(--muted);
    font-size: 0.875rem;
  }
</style>
