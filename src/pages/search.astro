---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="搜索" description="在项目案例中搜索关键词。" noindex>
  <header class="page-head">
    <p class="mono-label">搜索 / 全站</p>
    <h1>搜索</h1>
    <p class="lead">
      在项目案例中搜索技术、领域或关键词。任何时候按 <kbd>⌘K</kbd>（Windows 为 <kbd>Ctrl K</kbd>
      ）即可唤起。
    </p>
  </header>

  <div data-search-root>
    <form class="search-form" role="search" data-search-form>
      <label for="q" class="sr-only">
        搜索关键词
      </label>
      <input
        id="q"
        name="q"
        type="search"
        data-search-input
        placeholder="例如：YOLO、知识图谱、数据分析"
        autocomplete="off"
        spellcheck="false"
      />
      <kbd aria-hidden="true">⌘K</kbd>
    </form>

    <p class="status" role="status" aria-live="polite" data-search-status>
      输入关键词开始搜索
    </p>

    <ol class="results" aria-label="搜索结果" data-search-results></ol>

    <div class="empty" data-search-empty hidden>
      <p class="empty-title">没有找到匹配的内容</p>
      <p class="empty-desc">换个关键词试试，或者直接浏览项目库。</p>
      <a class="button" href={`${import.meta.env.BASE_URL}projects/`}>
        浏览全部项目
      </a>
    </div>

    <noscript>
      <p class="notice">
        搜索需要 JavaScript。你可以直接访问
        <a href={`${import.meta.env.BASE_URL}projects/`}>项目库</a> 浏览全部案例。
      </p>
    </noscript>
  </div>
</BaseLayout>

<script>
  import { initSearch } from "@/scripts/search";
  document.addEventListener("astro:page-load", initSearch);
</script>

<style>
  .page-head {
    max-width: 46rem;
    margin-bottom: clamp(2rem, 5vw, 3rem);
  }

  h1 {
    margin: 0.5rem 0 0.75rem;
    font-size: clamp(2.25rem, 6vw, 4rem);
    letter-spacing: -0.04em;
  }

  .lead {
    margin: 0;
    color: var(--muted);
  }

  kbd {
    font-family: var(--font-mono);
    font-size: 0.75em;
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.05rem 0.35rem;
    color: var(--fg);
    background: var(--surface);
  }

  .search-form {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    border-bottom: 1px solid var(--border-strong);
    padding-bottom: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .search-form input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    color: var(--fg);
    font: inherit;
    font-size: clamp(1.25rem, 2.6vw, 1.75rem);
    padding: 0.5rem 0;
  }

  .search-form input::placeholder {
    color: var(--muted);
    opacity: 0.8;
  }

  .search-form input:focus {
    outline: none;
  }

  .search-form:focus-within {
    border-bottom-color: var(--accent);
  }

  .status {
    margin: 0 0 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
  }

  .results {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border);
  }

  .results li {
    padding-block: 1.15rem;
    border-bottom: 1px solid var(--border);
  }

  .result-link {
    display: inline-block;
    font-size: clamp(1.05rem, 1.8vw, 1.2rem);
    font-weight: 600;
    text-decoration: none;
    margin-bottom: 0.35rem;
  }

  .result-link:hover {
    color: var(--accent);
  }

  .result-excerpt {
    margin: 0;
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.7;
  }

  .result-excerpt :global(mark) {
    background: color-mix(in oklch, var(--accent) 22%, transparent);
    color: var(--fg);
    border-radius: 3px;
    padding: 0 0.15em;
  }

  .empty {
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-lg);
    padding: 2.5rem 1.5rem;
    text-align: center;
  }

  .empty-title {
    margin: 0;
    font-weight: 600;
  }

  .empty-desc {
    margin: 0.35rem 0 1.25rem;
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .button {
    display: inline-block;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    padding: 0.6rem 1rem;
    text-decoration: none;
    font-size: 0.9375rem;
  }

  .notice {
    margin-top: 1.5rem;
    color: var(--muted);
    font-size: 0.875rem;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
