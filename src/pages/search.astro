---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { copy, type Lang } from "@/i18n";
import { localizePath } from "@/i18n/routing";

interface Props {
  lang?: Lang;
}

const { lang = "zh" } = Astro.props;
const c = copy[lang].search;
const projectsHref = localizePath("projects/", lang);
---

<BaseLayout title={c.title} description={c.lead} noindex lang={lang}>
  <header class="page-head">
    <p class="mono-label">{c.kicker}</p>
    <h1>{c.title}</h1>
    <p class="lead">{c.lead}</p>
    <nav class="quick-searches" aria-label={lang === "en" ? "Quick searches" : "快捷搜索"}>
      <span class="mono-label">{lang === "en" ? "Try" : "试试"}</span>
      {["YOLO", "知识图谱", "数据分析", "Astro"].map((term) => (
        <a href={`${localizePath("search/", lang)}?q=${encodeURIComponent(term)}`}>{term}</a>
      ))}
    </nav>
  </header>

  <div
    data-search-root
    data-msg-initial={c.initial}
    data-msg-short={c.short}
    data-msg-searching={c.searching}
    data-msg-found={c.found}
    data-msg-none={c.none}
    data-msg-missing={c.indexMissing}
  >
    <form class="search-form" role="search" data-search-form>
      <label for="q" class="sr-only">
        {c.title}
      </label>
      <input
        id="q"
        name="q"
        type="search"
        data-search-input
        placeholder={c.placeholder}
        autocomplete="off"
        spellcheck="false"
      />
      <kbd aria-hidden="true">⌘K</kbd>
    </form>

    <p class="status" role="status" aria-live="polite" data-search-status>
      {c.initial}
    </p>

    <ol class="results" aria-label={c.title} data-search-results></ol>

    <div class="empty" data-search-empty hidden>
      <p class="empty-title">{c.emptyTitle}</p>
      <p class="empty-desc">{c.emptyDesc}</p>
      <a class="button" href={projectsHref}>
        {c.browse}
      </a>
    </div>

    <noscript>
      <p class="notice">
        {c.noJs} <a href={projectsHref}>{c.noJsLink}</a>
      </p>
    </noscript>
  </div>
</BaseLayout>

<script>
  import { initSearch } from "@/scripts/search";
  document.addEventListener("astro:page-load", initSearch);
</script>

<style>
  .page-head {
    max-width: 46rem;
    margin-bottom: clamp(2rem, 5vw, 3rem);
  }

  h1 {
    margin: 0.5rem 0 0.75rem;
    font-size: clamp(2.25rem, 6vw, 4rem);
    letter-spacing: -0.04em;
  }

  .lead {
    margin: 0;
    color: var(--muted);
  }

  .quick-searches {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    margin-top: 1.1rem;
  }

  .quick-searches a {
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.78rem;
    text-decoration: none;
  }

  .quick-searches a:hover {
    border-color: var(--border-strong);
    color: var(--fg);
  }

  kbd {
    font-family: var(--font-mono);
    font-size: 0.75em;
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.05rem 0.35rem;
    color: var(--fg);
    background: var(--surface);
  }

  .search-form {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    border-bottom: 1px solid var(--border-strong);
    padding-bottom: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .search-form input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    color: var(--fg);
    font: inherit;
    font-size: clamp(1.25rem, 2.6vw, 1.75rem);
    padding: 0.5rem 0;
  }

  .search-form input::placeholder {
    color: var(--muted);
    opacity: 0.8;
  }

  .search-form input:focus {
    outline: none;
  }

  .search-form:focus-within {
    border-bottom-color: var(--accent);
  }

  .status {
    margin: 0 0 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
  }

  .results {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border);
  }

  .results li {
    padding-block: 1.15rem;
    border-bottom: 1px solid var(--border);
  }

  .result-link {
    display: inline-block;
    font-size: clamp(1.05rem, 1.8vw, 1.2rem);
    font-weight: 600;
    text-decoration: none;
    margin-bottom: 0.35rem;
  }

  .result-link:hover {
    color: var(--accent);
  }

  .result-excerpt {
    margin: 0;
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.7;
  }

  .result-excerpt :global(mark) {
    background: color-mix(in oklch, var(--accent) 22%, transparent);
    color: var(--fg);
    border-radius: 3px;
    padding: 0 0.15em;
  }

  .empty {
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-lg);
    padding: 2.5rem 1.5rem;
    text-align: center;
  }

  .empty-title {
    margin: 0;
    font-weight: 600;
  }

  .empty-desc {
    margin: 0.35rem 0 1.25rem;
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .button {
    display: inline-block;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    padding: 0.6rem 1rem;
    text-decoration: none;
    font-size: 0.9375rem;
  }

  .notice {
    margin-top: 1.5rem;
    color: var(--muted);
    font-size: 0.875rem;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
