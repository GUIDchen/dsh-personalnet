---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { USES } from "@/data/uses";
import { USES_EN } from "@/data/uses.en";
import { copy, type Lang } from "@/i18n";
import { localizePath } from "@/i18n/routing";

interface Props {
  lang?: Lang;
}

const { lang = "zh" } = Astro.props;
const c = copy[lang].uses;
const uses = lang === "en" ? USES_EN : USES;
---

<BaseLayout title={c.title} description={c.lead} lang={lang}>
  <header class="page-head">
    <p class="mono-label">{c.kicker}</p>
    <h1>{c.title}</h1>
    <p class="lead">{c.lead}</p>
    <p class="links">
      <a href={localizePath("now/", lang)}>{c.now}</a>
    </p>
  </header>

  <div class="groups">
    {uses.map((group) => (
      <section aria-labelledby={`uses-${group.title}`}>
        <h2 id={`uses-${group.title}`}>{group.title}</h2>
        <dl>
          {group.items.map((item) => (
            <div>
              <dt>{item.name}</dt>
              {item.note && <dd>{item.note}</dd>}
            </div>
          ))}
        </dl>
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  .page-head {
    max-width: 46rem;
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
  }

  h1 {
    margin: 0.5rem 0 1rem;
    font-size: clamp(2.25rem, 6vw, 4rem);
    letter-spacing: -0.04em;
  }

  .lead {
    margin: 0;
    color: var(--muted);
  }

  .links {
    margin: 1.25rem 0 0;
    font-size: 0.875rem;
  }

  .groups {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
  }

  section {
    border-top: 1px solid var(--border);
    padding-top: 1.25rem;
  }

  h2 {
    margin: 0 0 1rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  dl {
    margin: 0;
    display: grid;
    gap: 0.85rem;
  }

  dt {
    font-size: 1rem;
  }

  dd {
    margin: 0.15rem 0 0;
    font-size: 0.875rem;
    color: var(--muted);
  }
</style>
