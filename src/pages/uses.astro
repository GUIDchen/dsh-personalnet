---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { USES } from "@/data/uses";
import { profile } from "@/data/profile";

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="工具"
  description={`${profile.name} 常用的语言、AI/数据工具、系统与网站技术栈。`}
>
  <header class="page-head">
    <p class="mono-label">工具 / Uses</p>
    <h1>常用工具</h1>
    <p class="lead">按工作流整理，而不是逐条罗列。工具会变，方法比工具更重要。</p>
    <p class="links">
      <a href={`${base}now/`}>现在在做什么 →</a>
    </p>
  </header>

  <div class="groups">
    {USES.map((group) => (
      <section aria-labelledby={`uses-${group.title}`}>
        <h2 id={`uses-${group.title}`}>{group.title}</h2>
        <dl>
          {group.items.map((item) => (
            <div>
              <dt>{item.name}</dt>
              {item.note && <dd>{item.note}</dd>}
            </div>
          ))}
        </dl>
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  .page-head {
    max-width: 46rem;
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
  }

  h1 {
    margin: 0.5rem 0 1rem;
    font-size: clamp(2.25rem, 6vw, 4rem);
    letter-spacing: -0.04em;
  }

  .lead {
    margin: 0;
    color: var(--muted);
  }

  .links {
    margin: 1.25rem 0 0;
    font-size: 0.875rem;
  }

  .groups {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
  }

  section {
    border-top: 1px solid var(--border);
    padding-top: 1.25rem;
  }

  h2 {
    margin: 0 0 1rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  dl {
    margin: 0;
    display: grid;
    gap: 0.85rem;
  }

  dt {
    font-size: 1rem;
  }

  dd {
    margin: 0.15rem 0 0;
    font-size: 0.875rem;
    color: var(--muted);
  }
</style>
